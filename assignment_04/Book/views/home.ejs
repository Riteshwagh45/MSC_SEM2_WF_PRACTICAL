<!DOCTYPE html>
<html>
<head>
    <title>Recipe Book</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">
    <h1>Recipe Book</h1>

    <button onclick="showForm()">Add New Recipe</button>

    <div id="recipeForm" class="form-box">
        <form action="/add" method="POST">
            <input type="text" name="name" placeholder="Recipe Name" required>
            <input type="text" name="ingredients" placeholder="Ingredients" required>
            <textarea name="instructions" placeholder="Instructions" required></textarea>
            <button type="submit">Add Recipe</button>
        </form>
    </div>

    <h2>All Recipes</h2>

    <ul>
        <% recipes.forEach(recipe => { %>
            <li>
                <span><%= recipe.name %></span>

                <div class="actions">
                    
                    <a href="/recipe/<%= recipe.id %>" class="view-btn">View</a>

                    
                    <form action="/delete/<%= recipe.id %>" method="POST">
                        <button type="submit" class="delete-btn">Delete</button>
                    </form>
                </div>
            </li>
        <% }) %>
    </ul>
</div>

<script>
function showForm() {
    document.getElementById("recipeForm").style.display = "block";
}
</script>

</body>
</html>
