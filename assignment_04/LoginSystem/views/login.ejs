<!DOCTYPE html>
<html>
<head>
    <title>User Login</title>
</head>
<body>

<h2>User Login</h2>

<% if (error) { %>
  <p style="color:red;"><%= error %></p>
<% } %>

<form method="POST" action="/login">
  Username:
  <input type="text" name="username" required /><br><br>

  Password:
  <input type="password" name="password" required /><br><br>

  <button type="submit">Login</button>
</form>

</body>
</html>
